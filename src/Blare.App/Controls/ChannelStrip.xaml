<UserControl
    x:Class="BLight.Blare.App.Controls.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BLight.Blare.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border
        x:Name="StripBorder"
        Width="104"
        Padding="10,12"
        CornerRadius="{ThemeResource BlareStripCornerRadius}"
        Background="{ThemeResource BlareStripBackground}"
        BorderBrush="{ThemeResource BlareStripBorder}"
        BorderThickness="1">

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- App identity -->
            <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
                <Border
                    Width="36"
                    Height="36"
                    CornerRadius="8"
                    Background="{ThemeResource BlarePanelBackground}">
                    <Image x:Name="AppIcon" Width="22" Height="22" />
                </Border>
                <TextBlock
                    x:Name="AppNameText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="84" />
            </StackPanel>

            <!-- Boost badge, only visible while a boost pipeline is actually running -->
            <Border
                x:Name="BoostBadge"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Padding="7,2"
                CornerRadius="10"
                Background="#33E85D3A"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <FontIcon Glyph="&#xEC48;" FontSize="9" Foreground="{ThemeResource BlareMeterHigh}" />
                    <TextBlock Text="BOOST" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource BlareMeterHigh}" />
                </StackPanel>
            </Border>

            <!-- Meter + fader side by side, like a real channel strip -->
            <Grid Grid.Row="2" ColumnSpacing="8" MinHeight="150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    CornerRadius="3"
                    Padding="3"
                    Background="{ThemeResource BlarePanelBackground}">
                    <local:SpectrumMeter x:Name="Meter" BarCount="8" />
                </Border>

                <Grid Grid.Column="1" Width="36">
                    <!-- Danger zone: the slice of fader travel that sits above 100% -->
                    <Border
                        x:Name="DangerZone"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Width="4"
                        CornerRadius="2"
                        Background="{ThemeResource BlareMeterHigh}"
                        Opacity="0.35" />

                    <Slider
                        x:Name="VolumeSlider"
                        Orientation="Vertical"
                        Minimum="0"
                        Maximum="150"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        ValueChanged="OnVolumeSliderChanged" />
                </Grid>
            </Grid>

            <!-- Numeric readout -->
            <TextBlock
                x:Name="VolumeText"
                Grid.Row="3"
                Text="100%"
                FontSize="12"
                FontFamily="Consolas"
                HorizontalAlignment="Center" />

            <ToggleButton
                x:Name="MuteButton"
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                Padding="0,4"
                Checked="OnMuteToggled"
                Unchecked="OnMuteToggled">
                <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="14" />
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>

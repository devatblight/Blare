<Window
    x:Class="Blight.Blare.App.Views.TrayMixerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The window is the card: it already has an acrylic surface, so wrapping
         the content in another bordered panel would draw a box inside a box. -->
    <Grid
        x:Name="RootHost"
        Padding="14,12"
        RowSpacing="10"
        Background="{ThemeResource BlareStripBackground}"
        Opacity="0">

        <Grid.RenderTransform>
            <TranslateTransform x:Name="CardTransform" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Master output -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                x:Name="DeviceNameText"
                FontSize="11"
                Opacity="0.6"
                TextTrimming="CharacterEllipsis" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE7F5;"
                    FontSize="15"
                    Foreground="{ThemeResource BlareAccent}"
                    VerticalAlignment="Center" />

                <Slider
                    x:Name="MasterSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    VerticalAlignment="Center"
                    ValueChanged="OnMasterChanged" />

                <TextBlock
                    x:Name="MasterReadout"
                    Grid.Column="2"
                    FontFamily="Consolas"
                    FontSize="12"
                    MinWidth="40"
                    TextAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <Border
            Grid.Row="1"
            Height="1"
            Background="{ThemeResource BlareStripBorder}"
            Opacity="0.7" />

        <!-- One row per app, rebuilt each time the flyout opens. -->
        <StackPanel x:Name="AppRows" Grid.Row="2" Spacing="8" />
    </Grid>
</Window>

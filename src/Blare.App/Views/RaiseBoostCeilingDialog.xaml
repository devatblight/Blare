<ContentDialog
    x:Class="BLight.Blare.App.Views.RaiseBoostCeilingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Allow boosting past the safe limit?"
    PrimaryButtonText="Allow up to 300%"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MaxWidth="420">
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Warning"
            Title="150% is already a large boost"
            Message="Going higher increases the risk of hearing damage and audio distortion. This limit exists to make going past it a deliberate choice, not an accident." />

        <CheckBox
            x:Name="AcknowledgeCheckBox"
            Content="I understand this can cause hearing damage and I am choosing to proceed."
            Checked="OnGateChanged"
            Unchecked="OnGateChanged" />

        <TextBlock Text="Type &quot;allow&quot; to confirm:" />
        <TextBox
            x:Name="ConfirmationTextBox"
            PlaceholderText="allow"
            TextChanged="OnGateChanged" />
    </StackPanel>
</ContentDialog>

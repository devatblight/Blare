<ContentDialog
    x:Class="Blight.Blare.App.Views.RaiseBoostCeilingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="You're about to go past the safe limit"
    PrimaryButtonText="Yes, risk it — allow up to 300%"
    CloseButtonText="Stay at 150%"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonStyle="{StaticResource DangerButtonStyle}">

    <StackPanel Spacing="14" MaxWidth="420">
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Error"
            Title="150% is already a large boost"
            Message="Going higher meaningfully increases the risk of hearing damage and audio distortion. This limit exists so going past it is a deliberate choice, not an accident." />

        <CheckBox
            x:Name="AcknowledgeCheckBox"
            Content="I understand this can cause hearing damage and I am choosing to proceed."
            Checked="OnGateChanged"
            Unchecked="OnGateChanged" />

        <TextBlock Text="Type &quot;allow&quot; to confirm you mean it:" />
        <TextBox
            x:Name="ConfirmationTextBox"
            PlaceholderText="allow"
            TextChanged="OnGateChanged" />
    </StackPanel>
</ContentDialog>

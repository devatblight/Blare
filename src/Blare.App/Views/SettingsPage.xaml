<Page
    x:Class="Blight.Blare.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="4" MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="Startup" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />

            <controls:SettingsCard
                Header="Run when Windows starts"
                Description="Adds Blare to your startup apps. You can also turn this off from Task Manager's Startup tab.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RunAtStartupToggle" OnContent="On" OffContent="Off" Toggled="OnRunAtStartupToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="StartHiddenCard"
                Header="Start hidden in the tray"
                Description="Launch straight to the tray instead of opening a window.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B3;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartHiddenToggle" OnContent="On" OffContent="Off" Toggled="OnStartHiddenToggled" />
            </controls:SettingsCard>

            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,4" />

            <controls:SettingsCard
                Header="Theme"
                Description="Native Fluent matches stock Windows 11. Studio Dark uses darker panels and pro-audio accent colours.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeComboBox" MinWidth="160" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Native Fluent" Tag="NativeFluent" />
                    <ComboBoxItem Content="Studio Dark" Tag="StudioDark" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="BackdropCard"
                Header="Window material"
                Description="Mica tints with your wallpaper. Acrylic blurs what's behind the window. Mica Alt is a stronger tint.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81E;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BackdropComboBox" MinWidth="160" SelectionChanged="OnBackdropChanged">
                    <ComboBoxItem Content="Mica" Tag="Mica" />
                    <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                    <ComboBoxItem Content="None" Tag="None" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsExpander
                Header="Flyout position"
                Description="Where every message from Blare appears — warnings, update notices, everything.">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;" />
                </controls:SettingsExpander.HeaderIcon>

                <TextBlock x:Name="FlyoutPositionLabel" VerticalAlignment="Center" Opacity="0.7" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                        <StackPanel Spacing="10">
                            <!-- A mock display: pick the corner the flyout lives in. -->
                            <Border
                                Width="290"
                                Height="176"
                                CornerRadius="8"
                                Padding="8"
                                Background="{ThemeResource BlarePanelBackground}"
                                BorderBrush="{ThemeResource BlareStripBorder}"
                                BorderThickness="1">
                                <Grid x:Name="PositionGrid" RowSpacing="6" ColumnSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Border>

                            <!-- Monitor stand, so the mock reads as a screen -->
                            <Border
                                Width="70"
                                Height="5"
                                CornerRadius="3"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource BlareStripBorder}" />

                            <Button x:Name="PreviewFlyoutButton" Content="Show a test message" Click="OnPreviewFlyoutClick" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,4" />

            <controls:SettingsCard
                Header="Health warnings"
                Description="Warns when an app has been running near full volume for a while. Turning this off requires explicit confirmation and re-enables itself automatically after 30 days.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7BA;" />
                </controls:SettingsCard.HeaderIcon>
                <Button x:Name="ToggleWarningsButton" Content="Disable" Click="OnToggleWarningsClick" />
            </controls:SettingsCard>

            <controls:SettingsExpander
                Header="Quiet hours"
                Description="Holds every app under a ceiling during the hours you choose. Late-night listening is the case this exists for.">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE708;" />
                </controls:SettingsExpander.HeaderIcon>

                <ToggleSwitch x:Name="QuietHoursToggle" OnContent="On" OffContent="Off" Toggled="OnQuietHoursToggled" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="From" HorizontalContentAlignment="Right">
                        <TimePicker x:Name="QuietStartPicker" ClockIdentifier="24HourClock" SelectedTimeChanged="OnQuietHoursEdited" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Until" HorizontalContentAlignment="Right">
                        <TimePicker x:Name="QuietEndPicker" ClockIdentifier="24HourClock" SelectedTimeChanged="OnQuietHoursEdited" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Header="Ceiling"
                        Description="No app can be set above this while quiet hours are on."
                        HorizontalContentAlignment="Right">
                        <NumberBox
                            x:Name="QuietCeilingBox"
                            Minimum="0"
                            Maximum="100"
                            SpinButtonPlacementMode="Compact"
                            MinWidth="120"
                            ValueChanged="OnQuietCeilingChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard>
                        <TextBlock x:Name="QuietHoursSummary" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Margin="0,4,0,0"
                CornerRadius="8"
                Title="A note on measurement"
                Message="Blare measures relative audio signal level, not actual sound pressure at your ears — it can't know your speaker or headphone volume." />

            <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,4" />

            <controls:SettingsCard
                x:Name="UpdateCard"
                Header="Check for updates"
                Description="The only time Blare uses the network. It asks GitHub for the latest release and nothing about you is sent.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CheckUpdatesButton" Content="Check now" Click="OnCheckUpdatesClick" />
                    <ToggleSwitch
                        x:Name="UpdateChecksToggle"
                        OnContent="On"
                        OffContent="Off"
                        Toggled="OnUpdateChecksToggled" />
                </StackPanel>
            </controls:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,4" />

            <controls:SettingsExpander Header="Blare" Description="Per-app volume mixer with health safeguards, part of Blight">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsExpander.HeaderIcon>
                <TextBlock Text="0.2.0" VerticalAlignment="Center" Opacity="0.7" />
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>

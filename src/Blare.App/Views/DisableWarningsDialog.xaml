<ContentDialog
    x:Class="BLight.Blare.App.Views.DisableWarningsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="You're about to remove a safety protection"
    PrimaryButtonText="Yes, turn off my protection"
    CloseButtonText="Keep me protected"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonStyle="{StaticResource DangerButtonStyle}">

    <StackPanel Spacing="14" MaxWidth="420">
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Error"
            Title="This can cause hearing damage"
            Message="Blare warns you when an app has been running loud for a while. Without it, nothing stops volume from staying dangerously high for hours — you won't be warned again until this auto-restores itself in 30 days." />

        <CheckBox
            x:Name="AcknowledgeCheckBox"
            Content="I understand this can cause hearing damage and I am choosing to proceed."
            Checked="OnGateChanged"
            Unchecked="OnGateChanged" />

        <TextBlock Text="Type &quot;disable&quot; to confirm you mean it:" />
        <TextBox
            x:Name="ConfirmationTextBox"
            PlaceholderText="disable"
            TextChanged="OnGateChanged" />
    </StackPanel>
</ContentDialog>

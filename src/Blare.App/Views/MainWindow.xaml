<Window
    x:Class="BLight.Blare.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BLight.Blare.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Blare" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock
                Text="Per-app volume mixer"
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7" />
        </StackPanel>

        <InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="1"
            Margin="0,12,0,0"
            Severity="Warning"
            Title="Running loud"
            IsOpen="False" />

        <ListView
            x:Name="SessionListView"
            Grid.Row="2"
            Margin="0,16,0,0"
            SelectionMode="None"
            ItemsSource="{x:Bind Sessions}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionRowViewModel">
                    <Grid Margin="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="24"
                            Height="24"
                            Source="{x:Bind Icon, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind DisplayName}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                        <Slider
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind VolumePercent, Mode=TwoWay}"
                            VerticalAlignment="Center" />

                        <ToggleSwitch
                            Grid.Column="3"
                            OnContent="Muted"
                            OffContent="Muted"
                            IsOn="{x:Bind IsMuted, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,12,0,0">
            <HyperlinkButton
                x:Name="ToggleWarningsButton"
                Content="Disable health warnings"
                Click="OnToggleWarningsClick" />
        </StackPanel>
    </Grid>
</Window>

<Page
    x:Class="BLight.Blare.App.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BLight.Blare.App.ViewModels"
    xmlns:conv="using:BLight.Blare.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoostBorderConverter x:Key="BoostBorderConverter" />
        <!-- Slim, meter-shaped ProgressBar so the same control reads as a level meter, not a loading bar. -->
        <Style x:Key="MeterBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,14,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status strip: quick-glance indicators, not another list row. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Border
                CornerRadius="12"
                Padding="10,4"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEC48;" FontSize="12" Foreground="#FFFF8C00" />
                    <TextBlock x:Name="BoostedCountText" Text="0 boosted" FontSize="12" />
                </StackPanel>
            </Border>
            <Border
                CornerRadius="12"
                Padding="10,4"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="WarningCountText" Text="0 warnings" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>

        <InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="1"
            Severity="Warning"
            Title="Running loud"
            IsOpen="False"
            CornerRadius="8" />

        <!-- Master/output device: its own distinct card, not folded into the app list. -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            CornerRadius="10"
            Background="{ThemeResource AccentFillColorDisabledBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE7F5;" FontSize="18" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="MasterDeviceNameText" Text="Output device" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                    <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" ValueChanged="OnMasterVolumeChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3">
            <ItemsControl x:Name="SessionItemsControl" ItemsSource="{x:Bind Sessions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionRowViewModel">
                        <Border
                            Padding="16,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1,1,1,1"
                            BorderBrush="{x:Bind IsBoosted, Mode=OneWay, Converter={StaticResource BoostBorderConverter}}">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Source="{x:Bind Icon, Mode=OneWay}" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind DisplayName}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />

                                    <Slider
                                        Grid.Column="2"
                                        Minimum="0"
                                        Maximum="{x:Bind MaxVolumePercent, Mode=OneWay}"
                                        Value="{x:Bind VolumePercent, Mode=TwoWay}"
                                        VerticalAlignment="Center" />

                                    <Border
                                        Grid.Column="3"
                                        Padding="8,3"
                                        CornerRadius="4"
                                        Background="#33FF8C00"
                                        Visibility="{x:Bind IsBoosted, Mode=OneWay}"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xEC48;" FontSize="10" Foreground="#FFFF8C00" />
                                            <TextBlock Text="BOOSTED" FontSize="10" FontWeight="SemiBold" Foreground="#FFFF8C00" />
                                        </StackPanel>
                                    </Border>

                                    <ToggleSwitch
                                        Grid.Column="4"
                                        OnContent="Muted"
                                        OffContent="Muted"
                                        IsOn="{x:Bind IsMuted, Mode=TwoWay}" />
                                </Grid>

                                <ProgressBar
                                    Grid.Row="1"
                                    Margin="44,0,0,0"
                                    Style="{StaticResource MeterBarStyle}"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{x:Bind MeterPercent, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>

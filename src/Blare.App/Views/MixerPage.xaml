<Page
    x:Class="BLight.Blare.App.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BLight.Blare.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Master bus: the whole output, styled as the desk's master section -->
        <Border
            Grid.Row="0"
            Padding="14,12"
            CornerRadius="{ThemeResource BlareStripCornerRadius}"
            Background="{ThemeResource BlareStripBackground}"
            BorderBrush="{ThemeResource BlareStripBorder}"
            BorderThickness="1">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7F5;" FontSize="18" Foreground="{ThemeResource BlareAccent}" />
                    <StackPanel>
                        <TextBlock Text="MASTER" FontSize="10" FontWeight="Bold" Opacity="0.6" />
                        <TextBlock x:Name="MasterDeviceNameText" FontSize="12" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Slider
                    x:Name="MasterVolumeSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    VerticalAlignment="Center"
                    ValueChanged="OnMasterVolumeChanged" />

                <TextBlock
                    x:Name="MasterVolumeText"
                    Grid.Column="2"
                    Text="0%"
                    FontFamily="Consolas"
                    FontSize="13"
                    VerticalAlignment="Center"
                    MinWidth="44"
                    TextAlignment="Right" />
            </Grid>
        </Border>

        <!-- Status indicators -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Border x:Name="BoostChip" CornerRadius="12" Padding="10,4" Background="{ThemeResource BlarePanelBackground}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEC48;" FontSize="12" Foreground="{ThemeResource BlareMeterHigh}" />
                    <TextBlock x:Name="BoostedCountText" Text="0 boosted" FontSize="12" />
                </StackPanel>
            </Border>
            <Border x:Name="WarningChip" CornerRadius="12" Padding="10,4" Background="{ThemeResource BlarePanelBackground}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource BlareMeterMid}" />
                    <TextBlock x:Name="WarningCountText" Text="0 warnings" FontSize="12" />
                </StackPanel>
            </Border>
            <Border x:Name="ExposureChip" CornerRadius="12" Padding="10,4" Background="{ThemeResource BlarePanelBackground}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE917;" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="ExposureText" Text="0m loud" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>

        <InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="1"
            Margin="0,40,0,0"
            Severity="Warning"
            Title="Running loud"
            IsOpen="False"
            CornerRadius="8" />

        <!-- The desk itself: one strip per app, scrolling horizontally -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="StripsPanel" Orientation="Horizontal" Spacing="10" />
        </ScrollViewer>

        <TextBlock
            x:Name="EmptyStateText"
            Grid.Row="2"
            Text="Nothing is playing audio right now."
            Opacity="0.5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</Page>

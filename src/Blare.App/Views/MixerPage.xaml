<Page
    x:Class="Blight.Blare.App.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Blight.Blare.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Master console: device, fader, readout, and an inline status line.
             Deliberately one panel rather than a row of stat cards. -->
        <Border
            Grid.Row="0"
            Padding="14,10"
            CornerRadius="{ThemeResource BlareStripCornerRadius}"
            Background="{ThemeResource BlareStripBackground}"
            BorderBrush="{ThemeResource BlareStripBorder}"
            BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F5;" FontSize="16" Foreground="{ThemeResource BlareAccent}" />
                        <StackPanel>
                            <TextBlock Text="MASTER" FontSize="9" FontWeight="Bold" Opacity="0.5" />
                            <TextBlock
                                x:Name="MasterDeviceNameText"
                                FontSize="12"
                                MaxWidth="230"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <Slider
                        x:Name="MasterVolumeSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        VerticalAlignment="Center"
                        ValueChanged="OnMasterVolumeChanged" />

                    <TextBlock
                        x:Name="MasterVolumeText"
                        Grid.Column="2"
                        Text="0%"
                        FontFamily="Consolas"
                        FontSize="13"
                        VerticalAlignment="Center"
                        MinWidth="42"
                        TextAlignment="Right" />
                </Grid>

                <!-- Hardware volume built into displays, reached over DDC/CI.
                     A third layer Windows' own mixer never shows. -->
                <StackPanel x:Name="HardwarePanel" Spacing="6" Visibility="Collapsed">
                    <Border Height="1" Background="{ThemeResource BlareStripBorder}" />
                    <TextBlock Text="DISPLAY SPEAKERS" FontSize="9" FontWeight="Bold" Opacity="0.5" />
                    <StackPanel x:Name="HardwareRows" Spacing="4" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BlareStripBorder}" />

                <!-- Inline status: small indicator dots, not KPI tiles -->
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="BoostDot" Width="7" Height="7" Fill="{ThemeResource BlareMeterUnlit}" />
                        <TextBlock x:Name="BoostedCountText" Text="no boost" FontSize="11.5" Opacity="0.8" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="WarningDot" Width="7" Height="7" Fill="{ThemeResource BlareMeterUnlit}" />
                        <TextBlock x:Name="WarningCountText" Text="no warnings" FontSize="11.5" Opacity="0.8" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="ExposureDot" Width="7" Height="7" Fill="{ThemeResource BlareMeterUnlit}" />
                        <TextBlock x:Name="ExposureText" Text="0m loud today" FontSize="11.5" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="1"
            Severity="Warning"
            Title="Running loud"
            IsOpen="False"
            CornerRadius="6" />

        <InfoBar
            x:Name="FocusBanner"
            Grid.Row="2"
            Severity="Informational"
            Title="Focus mode"
            IsOpen="False"
            IsClosable="True"
            CloseButtonClick="OnFocusBannerClosed"
            CornerRadius="6" />

        <!-- The desk: one strip per app, scrolling horizontally -->
        <ScrollViewer
            Grid.Row="3"
            Padding="0,4,0,0"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <!-- Centred so a few strips don't sit against a wall of empty space. -->
            <StackPanel x:Name="StripsPanel" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" />
        </ScrollViewer>

        <TextBlock
            x:Name="EmptyStateText"
            Grid.Row="3"
            Text="Nothing is playing audio right now."
            Opacity="0.5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</Page>

<Page
    x:Class="Blight.Blare.App.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="16,12,16,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header. Matches the other pages so the sections read as one app
             rather than three unrelated screens. -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Mixer" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="HeaderSubtitle"
                    Text="Nothing playing"
                    FontSize="12"
                    Opacity="0.6" />
            </StackPanel>

            <ToggleButton
                x:Name="EditModeToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Rearrange the dashboard"
                Checked="OnEditModeChanged"
                Unchecked="OnEditModeChanged">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                    <TextBlock Text="Edit" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- Edit-mode bar, in a row of its own so it slides in under the header
             instead of fighting it for space. -->
        <StackPanel
            x:Name="EditTools"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Opacity="0"
            Visibility="Collapsed">
            <DropDownButton x:Name="AddCardButton" Content="Add card">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="AddCardFlyout" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                x:Name="TidyLayoutButton"
                Content="Tidy up"
                ToolTipService.ToolTip="Close the gaps between cards without changing their order"
                Click="OnTidyLayoutClick" />
            <Button x:Name="ResetLayoutButton" Content="Reset layout" Click="OnResetLayoutClick" />
            <TextBlock
                Text="Drag a card to move it, drag its corner to resize"
                VerticalAlignment="Center"
                FontSize="11.5"
                Opacity="0.55" />
        </StackPanel>

        <InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="2"
            Severity="Warning"
            Title="Running loud"
            IsOpen="False"
            CornerRadius="6">
            <!-- The bar takes a row of its own, so opening it pushes the dashboard
                 down. Repositioning the neighbours makes that a slide rather than
                 the desk jolting under the pointer. -->
            <InfoBar.Transitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </InfoBar.Transitions>
        </InfoBar>

        <!-- The dashboard: a 12x12 cell grid the user arranges. -->
        <Grid x:Name="DashboardSurface" Grid.Row="3" SizeChanged="OnSurfaceSizeChanged">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>

            <Canvas x:Name="GridGuides" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed" />
            <!-- Its own layer: the guides canvas is cleared on every redraw and
                 the card canvas is rebuilt whenever cards change. -->
            <Canvas x:Name="DropLayer" IsHitTestVisible="False" />
            <Canvas x:Name="CardCanvas" />
        </Grid>
    </Grid>
</Page>

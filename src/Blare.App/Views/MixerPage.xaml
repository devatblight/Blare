<Page
    x:Class="Blight.Blare.App.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="16,12,16,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Edit-mode bar. Out of edit mode this is just the toggle. -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="EditTools"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <DropDownButton x:Name="AddCardButton" Content="Add card">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AddCardFlyout" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ResetLayoutButton" Content="Reset layout" Click="OnResetLayoutClick" />
                <TextBlock
                    Text="Drag a card to move it, drag its corner to resize"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Opacity="0.55" />
            </StackPanel>

            <ToggleButton
                x:Name="EditModeToggle"
                Grid.Column="1"
                Checked="OnEditModeChanged"
                Unchecked="OnEditModeChanged">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                    <TextBlock Text="Edit" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="1"
            Severity="Warning"
            Title="Running loud"
            IsOpen="False"
            CornerRadius="6" />

        <!-- The dashboard: a 12x12 cell grid the user arranges. -->
        <Grid x:Name="DashboardSurface" Grid.Row="2" SizeChanged="OnSurfaceSizeChanged">
            <Canvas x:Name="GridGuides" IsHitTestVisible="False" Visibility="Collapsed" />
            <!-- Its own layer: the guides canvas is cleared on every redraw and
                 the card canvas is rebuilt whenever cards change. -->
            <Canvas x:Name="DropLayer" IsHitTestVisible="False" />
            <Canvas x:Name="CardCanvas" />
        </Grid>
    </Grid>
</Page>

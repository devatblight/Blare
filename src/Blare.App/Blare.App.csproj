<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Blight.Blare.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!--
      Defaults to unpackaged so plain `dotnet build`/`dotnet run` stay fast
      for local iteration. Pass -p:WindowsPackageType=MSIX (with
      -p:SelfContained=false) to produce the real MSIX distribution build —
      single-project MSIX via Package.appxmanifest, no separate packaging
      project needed since the Windows App SDK supports this directly.
      DISABLE_XAML_GENERATED_MAIN + Program.cs is the documented pattern for
      running unpackaged; it also works fine under MSIX.
    -->
    <!-- Required for single-project MSIX. Without it the packaging targets
         never run and the build quietly produces only the Windows App Runtime
         dependency packages, which look like a result but are not the app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- SettingsCard/SettingsExpander — the same native-feeling grouped-settings controls Windows' own Settings app and most polished WinUI3 apps use. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blare.Core\Blare.Core.csproj" />
    <ProjectReference Include="..\Blare.Audio\Blare.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      System.Drawing.Icon (process icon extraction) and
      System.Windows.Forms.NotifyIcon (tray icon, since WinUI 3 has no
      native tray API) — referenced directly rather than via
      UseWindowsForms=true, which pulls in WPF's markup compiler and
      conflicts with WinUI 3's own XAML compiler over *.xaml Page items.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>

<Project>

  <PropertyGroup>
    <!--
      Fallback version for local builds. Releases do not use this: the release
      workflow passes the version in from the git tag, which is the single
      source of truth. Keeping a number here that releases ignore avoids the
      classic drift where a file says 1.2.0 and the tag says 1.3.0.
    -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Company>Blight</Company>
    <Product>Blare</Product>
    <Authors>Blight</Authors>
  </PropertyGroup>

</Project>
